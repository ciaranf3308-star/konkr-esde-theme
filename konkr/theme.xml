            <fontSize>0.0135</fontSize>
            <color>${inkDim}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>

        <!-- The approved render shows only the footer line, not ES-DE's
             default help bar (which would overlap it). A theme helpsystem
             replaces the default one; parked off-screen and transparent. -->
        <helpsystem name="libHelp">
            <pos>0.5 1.05</pos>
            <origin>0.5 1</origin>
            <fontPath>${fontRegular}</fontPath>
            <fontSize>0.001</fontSize>
            <iconColor>00000000</iconColor>
            <textColor>00000000</textColor>
            <backgroundColor>00000000</backgroundColor>
            <entries>a</entries>
        </helpsystem>
    </view>
</theme>
