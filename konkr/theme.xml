<?xml version="1.0" encoding="UTF-8"?>
<!-- KONKR — standalone ES-DE theme for the AYANEO KONKR Pocket Block (960x720, 4:3).
     System view (rebuilt 2026-11-26): Art Book Next's structure verbatim —
     full-screen poster per system, itemScale 1, hero logo centred on top.
     The parallelogram slices are gone (they did not render on the Block).
     Game view: Crystal's gamelist geometry carried over VERBATIM (positions,
     sizes, fonts, bindings, carousel) — re-skinned to ivory paper / charcoal /
     amber only. Crystal's blue glow/wash, navy gradient and dark shards omitted.
     Bindings use ES-DE 3.5's <metadata>/<systemdata> properties (NOT ${game.*}
     or ${system.fullName} — those resolve empty at load and abort the parse). -->
<theme>
    <variables>
        <fontRegular>./fonts/DejaVuSans.ttf</fontRegular>
        <fontBold>./fonts/DejaVuSans-Bold.ttf</fontBold>
        <fontMedium>./fonts/Inter-Medium.ttf</fontMedium>
        <paper>F6EDE6</paper>
        <ink>2B2B2B</ink>
        <inkDim>5A554C</inkDim>
        <amber>E8A33D</amber>
        <cream>F5EFE0</cream>
        <railCharcoal>2E2D2B</railCharcoal>
    </variables>

    <!-- ================= SYSTEM VIEW =================
         REBUILT 2026-11-26 to Art Book Next's structure. The parallelogram
         slices are gone: on the user's Block they did not render at all —
         the carousel showed game screenshots + giant system-name text
         instead of the poster art (video proof ~03:13), while Art Book
         Next, same posters, same logos, full-screen items, looks clean on
         the same device. So: each system is ONE full-screen 960x720 poster
         (./systems/<theme>.png, opaque RGB), the carousel is ABN's exact
         shape (itemSize 1 1, itemScale 1, no maxItemCount, fan tilt is the
         engine default 7.5 deg), the hero logo sits centred on top, and
         the helpsystem is the bottom hints bar. No rails, no zoom, no
         divider bands. Fallback for a system with no poster (snes,
         androidapps, ps2, steam, ...): the plain charcoal _default.png
         tile + the ABN SVG logo — never game art, never giant text.
         Hardening vs the old design: the carousel textColor is 00000000
         (ABN does this too), so even if a poster file ever fails to load,
         the text fallback is invisible instead of a giant system name. -->
    <view name="system">
        <!-- solid black behind the posters; only peeks at the corners
             during the fan tilt between systems (ABN's systemBackground). -->
        <image name="bgSystem">
            <pos>0 0</pos>
            <size>1 1</size>
            <path>./art/bg_system.png</path>
            <zIndex>0</zIndex>
        </image>

        <!-- Art Book Next's system carousel, verbatim structure:
             full-screen items, itemScale 1 (ABN does NOT zoom — its
             selected only looks big because it is fully visible and
             centred while neighbours are clipped, plus the fan tilt),
             no maxItemCount (engine default 3.0, same as ABN), no
             itemStacking, itemTransitions animate, fastScrolling true.
             Neighbours at full brightness/opacity/saturation (1/1/1) —
             the old 0.85 dimming belonged to the slice design. -->
        <carousel name="sysCarousel">
            <pos>0 0</pos>
            <size>1 1</size>
            <origin>0 0</origin>
            <type>horizontal</type>
            <color>00000000</color>
            <textColor>00000000</textColor>
            <staticImage>./systems/${system.theme}.png</staticImage>
            <defaultImage>./systems/_default.png</defaultImage>
            <itemSize>1 1</itemSize>
            <itemScale>1</itemScale>
            <itemVerticalAlignment>center</itemVerticalAlignment>
            <unfocusedItemOpacity>1</unfocusedItemOpacity>
            <unfocusedItemSaturation>1</unfocusedItemSaturation>
            <unfocusedItemDimming>1</unfocusedItemDimming>
            <itemTransitions>animate</itemTransitions>
            <fastScrolling>true</fastScrolling>
            <zIndex>1</zIndex>
        </carousel>

        <!-- hero logo: the user's own generated logos, DIRECTLY on the
             poster art — no plate, no background (the charcoal plate was
             removed 2026-11-26 at his word). Custom PNGs
             (./art/hero-custom/<system>.png, transparent, pre-scaled to
             672px wide) load first; any system without one falls back to
             Art Book Next's white SVG logos (./art/hero-logos/). Centred
             at 0.5 0.5, ABN's logo position. maxSize (not size) so each
             logo keeps its own aspect; colour FFFFFF (no tint). Exactly
             ONE hero element — the overlapping-logos bug must not return.
             No heroName text, no heroPlate. -->
        <image name="heroLogo">
            <pos>0.5 0.5</pos>
            <maxSize>0.70 0.25</maxSize>
            <origin>0.5 0.5</origin>
            <path>./art/hero-custom/${system.theme}.png</path>
            <default>./art/hero-logos/${system.theme}.svg</default>
            <color>FFFFFF</color>
            <zIndex>5</zIndex>
        </image>

        <!-- bottom hints bar, ABN-style: the ES-DE helpsystem itself,
             dark pill at the bottom (SELECT / CHOOSE). No rail images. -->
        <helpsystem name="help-system-view">
            <scope>view</scope>
            <pos>0.5 0.9375</pos>
            <origin>0.5 1</origin>
            <fontPath>${fontRegular}</fontPath>
            <fontSize>0.03</fontSize>
            <iconColor>${cream}</iconColor>
            <textColor>${cream}</textColor>
            <backgroundColor>181818</backgroundColor>
            <backgroundCornerRadius>0.005</backgroundCornerRadius>
            <backgroundHorizontalPadding>0.01 0.01</backgroundHorizontalPadding>
            <backgroundVerticalPadding>0.015 0.02</backgroundVerticalPadding>
            <entryRelativeScale>0.9</entryRelativeScale>
            <entries>left/right,a</entries>
        </helpsystem>
    </view>

    <!-- ================= GAME LIST VIEW =================
         Crystal v18.5.2 gamelist, geometry verbatim. -->
    <view name="gamelist">
        <image name="libBackground">
            <pos>0 0</pos>
            <size>1 1</size>
            <origin>0 0</origin>
            <path>./art/bg_paper.png</path>
            <zIndex>1</zIndex>
        </image>

        <!-- clipped-corner metadata card, left -->
        <image name="libPanelMain">
            <pos>0.0046875 0.0104167</pos>
            <size>0.3671875 0.9791667</size>
            <origin>0 0</origin>
            <path>./art/panel_card.png</path>
            <zIndex>10</zIndex>
        </image>

        <!-- slim graphite system spine with rotated platform mark -->
        <image name="libRail">
            <pos>0.3796875 0.025</pos>
            <size>0.046875 0.95</size>
            <origin>0 0</origin>
            <path>./art/rails/${system.name}.png</path>
            <default>./art/rails/_default.png</default>
            <zIndex>10</zIndex>
        </image>

        <image name="libMarquee">
            <pos>0.01875 0.1666667</pos>
            <maxSize>0.3375 0.2833333</maxSize>
            <origin>0 0.5</origin>
            <imageType>marquee</imageType>
            <opacity>1.0</opacity>
            <zIndex>20</zIndex>
        </image>

        <text name="libDesc">
            <pos>0.0375 0.2941</pos>
            <size>0.2984375 0.1125</size>
            <origin>0 0</origin>
            <metadata>description</metadata>
            <fontPath>${fontMedium}</fontPath>
            <fontSize>0.0140</fontSize>
            <lineSpacing>1.32</lineSpacing>
            <color>${inkDim}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>top</verticalAlignment>
            <zIndex>20</zIndex>
        </text>

        <datetime name="libYear">
            <pos>0.0375 0.4266</pos>
            <size>0.1796875 0.075</size>
            <origin>0 0</origin>
            <metadata>releasedate</metadata>
            <format>%Y</format>
            <fontPath>${fontBold}</fontPath>
            <fontSize>0.044</fontSize>
            <color>${ink}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>top</verticalAlignment>
            <zIndex>20</zIndex>
        </datetime>

        <rating name="libRating">
            <pos>0.23125 0.4402</pos>
            <size>0.109375 0.0291667</size>
            <origin>0 0</origin>
            <filledPath>./art/star_filled.png</filledPath>
            <unfilledPath>./art/star_unfilled.png</unfilledPath>
            <hideIfZero>true</hideIfZero>
            <zIndex>20</zIndex>
        </rating>

        <text name="libGenre">
            <pos>0.0375 0.5216</pos>
            <size>0.2984375 0.0291667</size>
            <origin>0 0</origin>
            <metadata>genre</metadata>
            <letterCase>uppercase</letterCase>
            <fontPath>${fontBold}</fontPath>
            <fontSize>0.022</fontSize>
            <color>${ink}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>top</verticalAlignment>
            <zIndex>20</zIndex>
        </text>

        <text name="libPlayers">
            <pos>0.0375 0.5708</pos>
            <size>0.140625 0.0270833</size>
            <origin>0 0</origin>
            <metadata>players</metadata>
            <letterCase>uppercase</letterCase>
            <fontPath>${fontMedium}</fontPath>
            <fontSize>0.0145</fontSize>
            <color>${inkDim}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>top</verticalAlignment>
            <zIndex>20</zIndex>
        </text>

        <text name="libDev">
            <pos>0.1875 0.5708</pos>
            <size>0.1640625 0.0541667</size>
            <origin>0 0</origin>
            <metadata>developer</metadata>
            <letterCase>uppercase</letterCase>
            <fontPath>${fontMedium}</fontPath>
            <fontSize>0.0145</fontSize>
            <color>${inkDim}</color>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>top</verticalAlignment>
            <zIndex>20</zIndex>
        </text>

        <image name="libScreenshot">
            <pos>0.0375 0.79</pos>
            <maxSize>0.29 0.29</maxSize>
            <origin>0 0.5</origin>
            <imageType>image</imageType>
            <zIndex>20</zIndex>
        </image>

        <video name="libVideo">
            <pos>0.0375 0.79</pos>
            <maxSize>0.29 0.29</maxSize>
            <imageMaxSize>0.29 0.29</imageMaxSize>
            <origin>0 0.5</origin>
            <imageType>image</imageType>
            <delay>5</delay>
            <zIndex>21</zIndex>
        </video>

        <image name="libSelectedShadow">
            <pos>0.703125 0.7708333</pos>
            <size>0.375 0.075</size>
            <origin>0.5 0.5</origin>
            <path>./art/lib_shadow_soft.png</path>
            <opacity>0.8</opacity>
            <zIndex>49</zIndex>
        </image>

        <!-- Crystal's vertical media carousel: selected cart/disc/box large,
             in full colour, original aspect; neighbours dimmed, clipped. -->
        <carousel name="gameCarousel">
            <type>vertical</type>
            <color>00000000</color>
            <pos>0.703125 0.4666667</pos>
            <size>0.5 1.53125</size>
            <origin>0.5 0.5</origin>
            <imageType>physicalmedia 3dbox</imageType>
            <defaultImage>./media_fallbacks/${system.name}.png</defaultImage>
            <itemSize>0.1875 0.25</itemSize>
            <itemScale>2.25</itemScale>
            <maxItemCount>3</maxItemCount>
            <itemsBeforeCenter>1</itemsBeforeCenter>
            <itemsAfterCenter>1</itemsAfterCenter>
            <itemHorizontalAlignment>center</itemHorizontalAlignment>
            <reflections>false</reflections>
            <unfocusedItemOpacity>0.45</unfocusedItemOpacity>
            <unfocusedItemSaturation>0.5</unfocusedItemSaturation>
            <unfocusedItemDimming>0.55</unfocusedItemDimming>
            <imageInterpolation>linear</imageInterpolation>
            <itemTransitions>animate</itemTransitions>
            <fastScrolling>true</fastScrolling>
            <zIndex>50</zIndex>
        </carousel>

        <image name="libTitleRule">
            <pos>0.703125 0.7458333</pos>
            <size>0.234375 0.0104167</size>
            <origin>0.5 0.5</origin>
            <path>./art/title_rule.png</path>
            <zIndex>59</zIndex>
        </image>

        <text name="libGameName">
            <pos>0.703125 0.7666667</pos>
            <size>0.58 0.0375</size>
            <origin>0.5 0.5</origin>
            <metadata>name</metadata>
            <letterCase>uppercase</letterCase>
            <fontPath>${fontBold}</fontPath>
            <fontSize>0.0275</fontSize>
            <color>${ink}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>

        <text name="libMetaGenre">
            <pos>0.6378906 0.7994792</pos>
            <size>0.140625 0.02</size>
            <origin>0.5 0.5</origin>
            <metadata>genre</metadata>
            <letterCase>uppercase</letterCase>
            <fontPath>${fontRegular}</fontPath>
            <fontSize>0.0145</fontSize>
            <color>${inkDim}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>

        <text name="libMetaSep1">
            <pos>0.7140625 0.7994792</pos>
            <size>0.0117188 0.02</size>
            <origin>0.5 0.5</origin>
            <fontPath>${fontRegular}</fontPath>
            <text>&#8226;</text>
            <fontSize>0.0145</fontSize>
            <color>${inkDim}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>

        <datetime name="libMetaYear">
            <pos>0.7363281 0.7994792</pos>
            <size>0.0328125 0.02</size>
            <origin>0.5 0.5</origin>
            <metadata>releasedate</metadata>
            <format>%Y</format>
            <fontPath>${fontRegular}</fontPath>
            <fontSize>0.0145</fontSize>
            <color>${inkDim}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </datetime>

        <text name="libMetaSep2">
            <pos>0.7585937 0.7994792</pos>
            <size>0.0117188 0.02</size>
            <origin>0.5 0.5</origin>
            <fontPath>${fontRegular}</fontPath>
            <text>&#8226;</text>
            <fontSize>0.0145</fontSize>
            <color>${inkDim}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
        </text>

        <text name="libMetaPlayers">
            <pos>0.8015625 0.7994792</pos>
            <size>0.0742188 0.02</size>
            <origin>0.5 0.5</origin>
            <metadata>players</metadata>
            <letterCase>uppercase</letterCase>
            <fontPath>${fontRegular}</fontPath>
            <fontSize>0.0145</fontSize>
            <color>${inkDim}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>60</zIndex>
